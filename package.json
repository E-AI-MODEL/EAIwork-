{
  "name": "eai-work",
  "version": "0.2.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "eai": "packages/cli/src/eai.ts"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.ts\" && node conformance/run.ts",
    "conformance": "node conformance/run.ts",
    "lint:pack": "node packages/cli/src/eai.ts lint-pack packs/sow-demo/pack.json",
    "replay:demo": "EAI_NOW=2026-10-05 node packages/cli/src/eai.ts replay packs/sow-demo/pack.json examples/demo/events.jsonl",
    "serve": "node packages/server/src/server.ts",
    "demo:dashboard": "node scripts/local-demo.ts",
    "local:ollama": "node scripts/local-ollama.ts",
    "proof:first-product": "EAI_FIRST_PRODUCT_SMOKE=1 node --test tests/first-product-smoke.test.ts"
  }
}
